<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TempsDeFlors" parent="android:Theme.Material.Light.NoActionBar" />





    <!-- L'estil de la SplashScreen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Color del fons de la pantalla -->
        <item name="windowSplashScreenBackground">#A2D9C5</item>

        <!-- Icona central (pot ser un vector, PNG o una icona animada) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo70_shw</item>

        <!-- Quant de temps es mostra la icona (només si és animada, max 1000ms) -->
        <item name="windowSplashScreenAnimationDuration">200</item>

        <!-- Opcional: Imatge de marca a la part inferior (com el "from Meta" de WhatsApp) -->
        <item name="windowSplashScreenIconBackgroundColor">#EEEEEE</item> <!-- Color darrere la icona -->

        <!-- Tema al qual ha de canviar quan s'acabi la càrrega -->
        <item name="postSplashScreenTheme">@style/Theme.TempsDeFlors</item>
    </style>


    <style name="EstrellaStyle">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:padding">2dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">#FFD700</item>
    </style>


</resources>

